# 平台多账号档案（v1.5.5 起由程序自动生成，含 cookie，不进库）
*_accounts.json
*.json.migrated

# ── 乐课 · 本仓库补充 ─────────────────────────────────────────
# 超星多账号档案文件名是 accounts.json（不以 _accounts 结尾），但同样含 cookie
accounts.json
# 本机界面设置（窗口尺寸、上次停留页等）
gui_settings.json
# 打包产物，200MB+，可重建（含 dist_165_final / dist_166 这类带版本号后缀的）
dist*/
build/
# 验收截图 / 预览图（可由 GUIAUTO_SHOT_DIR 重新生成）
_shots/
preview/
# 运行期由 build_qss() 生成的 QSS 图标（check/arrow.png）
assets/
# 本地知识库：用户答题沉淀，属用户数据
知识库/
# 本机配置备份
*.bak_*
# ⚠ 配置模板必须入库：上面的 config*.ini 会误伤它，放末尾做例外
!config_template.ini

# Runtime credentials and pending usage records
cookies_*.txt
.token_usage_pending/
*.pem
*.key
_dist_*/
